# Managed by ansible - roles/fuel_signal
[Unit]
Description=fuel-price-signal: fetch live prices and print buy/wait signal
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={{ fuel_signal_user }}
WorkingDirectory={{ fuel_signal_repo_dir }}
EnvironmentFile={{ fuel_signal_env_file }}
Environment=UV_PYTHON_PREFERENCE=only-system
ExecStart=/usr/local/bin/fuelsignal-signal-check.sh
