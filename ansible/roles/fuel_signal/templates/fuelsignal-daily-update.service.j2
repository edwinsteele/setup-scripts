# Managed by ansible - roles/fuel_signal
[Unit]
Description=fuel-price-signal: daily git pull, DB update, classify, LGA leadership
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={{ fuel_signal_user }}
WorkingDirectory={{ fuel_signal_repo_dir }}
Environment=UV_PYTHON_PREFERENCE=only-system
ExecStart=/usr/local/bin/fuelsignal-daily-update.sh
