#!/bin/sh
# Managed by ansible - roles/fuel_signal
# Pulls the checkout to latest (today's snapshot CSV, committed by
# upstream's own daily-snapshot GitHub Action, arrives this way - see
# README's "Daily update" section), syncs dependencies, then mirrors
# upstream's own "Daily DB update" GitHub Actions workflow: load the new
# snapshot, forward-fill daily_prices, then re-classify stations and
# re-score LGA leadership for *today only* (both default to a single-date
# run - see fuel_signal.classify/lga_leadership --help - not the
# --start-date backfill mode used for a from-scratch rebuild), then
# precompute the /api/v1 signal cache. Then restarts
# fuelsignal-workbench.service - this IS the restart that puts newly-pulled
# *code* live (see fuelsignal-deploy.sh.j2's own comment: that script
# exists for an on-demand restart, this one now means the workbench never
# runs code more than a day stale) - and warms its key pages so the first
# real visitor isn't the one paying for cold-start latency. All output
# lands in the journal via this unit's stdout/stderr.
#
# fill alone isn't enough for the always-on workbench: /classification-health
# reads station_class/classification_summary and /lead-lag reads
# lga_leadership, neither of which fill touches - only classify/
# lga_leadership populate those. /api/v1/stations and /api/v1/recommendation
# likewise need fuel_signal.generate_signal_cache's table - without it they
# return HTTP 503 rather than a stale or empty payload. No fuel_signal.signal
# call - the buy/wait CLI signal isn't needed here.
#
# set -e means a failure in any step below (including generate_signal_cache)
# aborts the script before the restart, same as classify/lga_leadership -
# the workbench keeps serving whatever cache/code it already has rather than
# restarting into a stale or missing one.
#
# --snapshot-date is passed explicitly (UTC, computed here) rather than
# left to classify/lga_leadership's own `date.today()` default, which
# reads the host's local date - same reasoning fuel_signal_daily_update_
# oncalendar is explicit UTC rather than relying on viking's system
# timezone.
#
# Runs as root (unlike the rest of this script's work, which belongs to
# {{ fuel_signal_user }}) because restarting fuelsignal-workbench.service
# needs it - the repo/dependency/DB steps below still run as
# {{ fuel_signal_user }} via runuser, same pattern as fuelsignal-deploy.sh.
set -eu

if [ "$(id -u)" -ne 0 ]; then
    echo "Must run as root" >&2
    exit 1
fi

repo="{{ fuel_signal_repo_dir }}"

runuser -u {{ fuel_signal_user }} -- git -C "$repo" pull --ff-only
runuser -u {{ fuel_signal_user }} -- env UV_PYTHON_PREFERENCE=only-system /usr/local/bin/uv sync --directory "$repo"

today="$(date -u +%Y-%m-%d)"
runuser -u {{ fuel_signal_user }} -- env UV_PYTHON_PREFERENCE=only-system /usr/local/bin/uv run --directory "$repo" python -m fuel_signal.db
runuser -u {{ fuel_signal_user }} -- env UV_PYTHON_PREFERENCE=only-system /usr/local/bin/uv run --directory "$repo" python -m fuel_signal.fill
runuser -u {{ fuel_signal_user }} -- env UV_PYTHON_PREFERENCE=only-system /usr/local/bin/uv run --directory "$repo" python -m fuel_signal.classify --snapshot-date "$today"
runuser -u {{ fuel_signal_user }} -- env UV_PYTHON_PREFERENCE=only-system /usr/local/bin/uv run --directory "$repo" python -m fuel_signal.lga_leadership --snapshot-date "$today"
runuser -u {{ fuel_signal_user }} -- env UV_PYTHON_PREFERENCE=only-system /usr/local/bin/uv run --directory "$repo" python -m fuel_signal.generate_signal_cache

systemctl restart fuelsignal-workbench.service

base="http://{{ fuel_signal_workbench_host }}:{{ fuel_signal_workbench_port }}"

echo "Waiting up to {{ fuel_signal_workbench_warmup_ready_timeout_seconds }}s for fuelsignal-workbench.service to accept connections"
ready=0
waited=0
while [ "$waited" -lt {{ fuel_signal_workbench_warmup_ready_timeout_seconds }} ]; do
    if curl -fsS --max-time 5 -o /dev/null "$base/healthz" 2>/dev/null; then
        ready=1
        break
    fi
    sleep 5
    waited=$((waited + 5))
done

if [ "$ready" -ne 1 ]; then
    echo "fuelsignal-workbench.service never answered /healthz within {{ fuel_signal_workbench_warmup_ready_timeout_seconds }}s - skipping warm-up" >&2
else
    # Single-shot, generous timeout, no --retry: the view function keeps
    # running server-side to completion even if curl gives up, so retrying
    # here would just stack duplicate concurrent copies of the same
    # expensive query on top of the one already in flight.
{% for path in fuel_signal_workbench_warmup_paths %}
    echo "Warming {{ path }}"
    curl -fsS --max-time {{ fuel_signal_workbench_warmup_timeout_seconds }} \
        -o /dev/null -w 'warmed %{url_effective} in %{time_total}s (HTTP %{http_code})\n' \
        "$base{{ path }}" || echo "Warm-up request to {{ path }} did not complete within {{ fuel_signal_workbench_warmup_timeout_seconds }}s" >&2
{% endfor %}
fi
