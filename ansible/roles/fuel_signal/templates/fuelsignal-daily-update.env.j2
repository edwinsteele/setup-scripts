# Managed by ansible - roles/fuel_signal
# EnvironmentFile= for fuelsignal-daily-update.service: the settings
# fuel_signal.send_push reads. The key's path and ID only - the key itself
# lives in APNS_KEY_PATH, readable by {{ fuel_signal_user }} alone.
APNS_KEY_PATH={{ fuel_signal_apns_key_path }}
APNS_KEY_ID={{ fuel_signal_apns_key_id }}
APNS_TEAM_ID={{ fuel_signal_apns_team_id }}
APNS_TOPIC={{ fuel_signal_apns_topic }}
APNS_ENV={{ fuel_signal_apns_env }}
