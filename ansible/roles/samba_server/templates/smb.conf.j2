# Managed by ansible - roles/samba_server
# Share stanzas below are owned by roles/samba_timemachine and
#  roles/samba_media respectively (this role only owns [global] and the
#  packages/service/firewalld plumbing) - their variables are available
#  here because role defaults are merged into the play at parse time,
#  regardless of role execution order.
[global]
   workgroup = {{ samba_workgroup }}
   netbios name = {{ samba_netbios_name }}
   server string = {{ ansible_facts['hostname'] }} Samba server
   security = user
   map to guest = bad user
   min protocol = SMB2
   log file = /var/log/samba/log.%m
   max log size = 1000
   logging = file

[{{ samba_timemachine_share_name }}]
   path = {{ samba_timemachine_share_path }}
   valid users = {{ samba_timemachine_valid_users }}
   read only = no
   browseable = yes
   vfs objects = catia fruit streams_xattr
   fruit:aapl = yes
   fruit:time machine = yes
{% if samba_timemachine_max_size %}
   fruit:time machine max size = {{ samba_timemachine_max_size }}
{% endif %}
   fruit:metadata = stream
   fruit:model = MacSamba
   durable handles = yes
   kernel oplocks = no
   kernel share modes = no
   posix locking = no

[{{ samba_media_share_name }}]
   path = {{ samba_media_share_path }}
   guest ok = yes
   read only = yes
   write list = {{ samba_media_write_users }}
   browseable = yes
