# -a: enable all standard monitoring. -o on / -S on: persist Automatic
# Offline Data Collection and Attribute Autosave across power cycles. -s:
# scheduled self-tests - short daily at 02:00, long weekly on Saturday
# (day 6) at 03:00. -m root: mail root (relayed out by mail_sender's
# postfix satellite) on any failure/threshold trip, via smartmontools'
# default warning script. See the "Disk power management" README section.
{{ samba_server_disk_device }} -a -o on -S on -s (S/../.././02|L/../../6/03) -m root
