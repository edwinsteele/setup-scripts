# Managed by ansible - roles/home_assistant
# UI-managed runtime state - not hand-edited, and not usefully diffable
# (JSON blobs, and some of it holds plaintext integration credentials).
# Recovered via Home Assistant's own Backup feature instead of git
# history - see the role README for why this is excluded rather than
# tracked-and-encrypted.
.storage/
.cloud/

# HA's own Backup archives - these are tarballs of (among other things)
# .storage/, so they hold the exact same plaintext credentials .storage/
# is excluded above for. Never let these into git history.
backups/

# Referenced via !secret in the tracked YAML - kept out of git entirely.
secrets.yaml

*.log
*.log.*
*.db
*.db-*
deps/
tts/
image/

# HA's own icon cache - regenerates itself, nothing to diff or restore.
.cache/
.HA_VERSION
.ha_run.lock
