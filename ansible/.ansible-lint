# 'min' is the highest profile this repo currently passes cleanly. Higher
# profiles (basic and up) surface a large pre-existing backlog - var-naming,
# name-casing, no-changed-when, octal-values, role-name pattern, unnamed
# plays, risky-file-permissions - that's real but out of scope for this
# modernization pass; raising this profile is a separate future project.
profile: min

skip_list:
